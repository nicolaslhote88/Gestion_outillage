        "jsCode": "const root = $('Init Processor Config').first().json || {};\nconst files = Array.isArray($json.files) ? [...$json.files] : [];\nconst partFiles = files.filter(f => /__part_\\d+\\.json$/i.test(String(f.name || '')));\nreturn [{\n  json: {\n    ...root,\n    part_json_files: partFiles,\n    part_json_count: partFiles.length\n  }\n}];"
