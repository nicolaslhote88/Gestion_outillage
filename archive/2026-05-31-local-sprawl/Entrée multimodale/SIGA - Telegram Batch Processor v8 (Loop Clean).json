    {
      "parameters": {
        "jsCode": "const out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const p = item.json.part || {};\n  const mime = String(item.json.computed_mime_type || item.binary?.data?.mimeType || 'application/octet-stream').toLowerCase();\n  const isImg = mime.startsWith('image/');\n  const bKey = isImg ? `image_upload${i}` : `document_upload${i}`;\n  \n  const row = {\n    index: i + 1,\n    order: item.json.media_order,\n    filename: p.original_filename || item.json.drive_file_name,\n    mime_type: mime,\n    binary_key: bKey\n  };\n\n  out.push({\n    json: {\n      ...item.json,\n      image_row: isImg ? row : null,\n      document_row: !isImg ? row : null\n    },\n    binary: item.binary\n  });\n}\nreturn out;"
      },
      "id": "4cf6686d-0c67-42af-b941-5919959fec67",
      "name": "Classify Media (No Base64)",
      "type": "n8n-nodes-base.code",
      "position": [
        33632,
        4976
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items.length) return [{ json: { payload_ready: false } }];\n\nconst root = items[0].json;\nconst sharedSecret = $('Init Processor Config').first().json.shared_secret || '';\n\nconst images = items.map(i => i.json.image_row).filter(Boolean).sort((a, b) => a.order - b.order);\nconst documents = items.map(i => i.json.document_row).filter(Boolean).sort((a, b) => a.order - b.order);\n\nimages.forEach((img, idx) => img.index = idx + 1);\ndocuments.forEach((doc, idx) => doc.index = idx + 1);\n\nconst sender = root.sender || {};\n\nconst payload = {\n  source: 'telegram_buffered',\n  trigger_source: 'telegram_buffer_batch',\n  project: 'SIGA',\n  entity_type: 'equipment',\n  message: {\n    text: root.message_text || '',\n    received_at: new Date().toISOString()\n  },\n  sender: {\n    id: sender.id || null,\n    display_name: sender.first_name || sender.username || sender.display_name || null\n  },\n  context: {\n    telegram: {\n      chat_id: root.chat_id ?? null,\n      chat_type: root.chat_type ?? null,\n      media_group_id: root.media_group_id || null,\n      group_key: root.group_key || null,\n      buffer_prefix: root.buffer_prefix || null\n    }\n  },\n  images: images.map(img => ({ index: img.index, filename: img.filename, mime_type: img.mime_type, binary_key: img.binary_key })),\n  documents: documents.map(doc => ({ index: doc.index, filename: doc.filename, mime_type: doc.mime_type, binary_key: doc.binary_key })),\n  headers: {\n    'x-siga-shared-secret': sharedSecret\n  },\n  processed_marker_name: root.processed_marker_name,\n  buffer_folder_id: root.buffer_folder_id,\n  group_key: root.group_key,\n  buffer_prefix: root.buffer_prefix,\n  payload_ready: true\n};\n\nconst outBinary = {};\nitems.forEach((item) => {\n  const row = item.json.image_row || item.json.document_row;\n  if (row && item.binary && item.binary.data) {\n    outBinary[row.binary_key] = item.binary.data;\n    outBinary[row.binary_key].fileName = row.filename;\n    outBinary[row.binary_key].mimeType = row.mime_type;\n  }\n});\n\nreturn [{\n  json: payload,\n  binary: Object.keys(outBinary).length ? outBinary : undefined\n}];"
      },
