    {
      "parameters": {
        "jsCode": "const root = $('If Not Processed').first().json;\nconst files = Array.isArray($json.files) ? $json.files : [];\nconst parts = Array.isArray(root.group_parts) ? root.group_parts : [];\nconst byName = new Map(files.map(f => [String(f.name || ''), f]));\nconst mediaItems = [];\n\nfor (const p of parts) {\n  const name = p.buffer_file_name;\n  if (!name) continue;\n  const f = byName.get(String(name));\n  if (!f) continue;\n  mediaItems.push({\n    ...root,\n    part: p,\n    drive_file_id: f.id,\n    drive_file_name: f.name,\n    computed_mime_type: f.mimeType || p.mime_type || 'application/octet-stream',\n    media_order: Number(p.message_id || mediaItems.length + 1)\n  });\n}\nreturn mediaItems;"
      },
      "id": "f60f998e-a1d9-4d3f-9a7d-f8928b5dccb8",
      "name": "Build Media Plan",
