    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  let txt = '';\n  try {\n    const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n    txt = Buffer.from(buf).toString('utf8');\n  } catch (e) { continue; }\n  txt = String(txt || '').replace(/^\\uFEFF/, '').trim();\n  const parsed = JSON.parse(txt);\n  out.push({\n    json: {\n      ...item.json,\n      part: parsed,\n      buffer_prefix: parsed.buffer_prefix || item.json.buffer_prefix || '',\n      group_key: parsed.group_key || ''\n    }\n  });\n}\nreturn out;"
      },
      "id": "0e6fbd1c-1486-48c9-9c38-5a07e35a88af",
      "name": "Parse Part JSON",
      "type": "n8n-nodes-base.code",
      "position": [
        31616,
        5144
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst items = $input.all().map(i => i.json || {});\nconst groups = new Map();\n\nconst firstNonEmpty = (arr, keys) => {\n  for (const x of arr) {\n    for(const key of keys) {\n        const val = x[key] || x.part?.[key];\n        if (val !== null && val !== undefined && val !== '') return val;\n    }\n  }\n  return null;\n};\n\nfor (const j of items) {\n  const prefix = j.buffer_prefix || '';\n  if (!prefix) continue;\n  const g = groups.get(prefix) || { parts: [], root: j, lastQuietUntil: 0, firstSeen: Number.MAX_SAFE_INTEGER };\n  const part = j.part || {};\n  g.parts.push(part);\n  const q = Date.parse(part.quiet_until || '') || 0;\n  const seen = Date.parse(part.message_received_at || '') || now;\n  if (q > g.lastQuietUntil) g.lastQuietUntil = q;\n  if (seen < g.firstSeen) g.firstSeen = seen;\n  groups.set(prefix, g);\n}\n\nconst ready = [...groups.values()]\n  .filter(g => g.lastQuietUntil > 0 && g.lastQuietUntil <= now)\n  .sort((a, b) => a.firstSeen - b.firstSeen);\n\nif (!ready.length) return [{ json: { ready_group_found: false, reason: 'no_ready_group' } }];\n\nconst g = ready[0];\nconst parts = [...g.parts].sort((a, b) => Number(a.message_id || 0) - Number(b.message_id || 0));\nconst markerName = `${g.root.buffer_prefix}processed.json`;\n\nreturn [{\n  json: {\n    ...$('Init Processor Config').first().json,\n    ready_group_found: true,\n    buffer_prefix: g.root.buffer_prefix,\n    group_key: g.root.group_key,\n    media_group_id: firstNonEmpty(parts, ['media_group_id']),\n    chat_id: firstNonEmpty(parts, ['chat_id']),\n    chat_type: firstNonEmpty(parts, ['chat_type']),\n    sender: firstNonEmpty(parts, ['sender']) || {},\n    message_text: firstNonEmpty(parts, ['message_text', 'caption_text', 'text']) || '',\n    quiet_until: new Date(g.lastQuietUntil).toISOString(),\n    group_parts: parts,\n    processed_marker_name: markerName\n  }\n}];"
      },
