{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIGA Brief terrain",
  "description": "Contrat de donnees entre n8n (depot) et Claude Cowork (traitement). Un brief = une saisie terrain Telegram.",
  "type": "object",
  "required": ["brief_id", "created_at", "source", "status", "text", "photos"],
  "properties": {
    "brief_id": {
      "type": "string",
      "description": "Identifiant unique du brief. Format: <YYYYMMDD-HHmmss>_msg<message_id>."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Horodatage ISO 8601 de reception (UTC)."
    },
    "source": {
      "type": "string",
      "enum": ["telegram"],
      "description": "Canal de saisie."
    },
    "status": {
      "type": "string",
      "enum": ["pending", "processing", "processed", "error"],
      "description": "pending = a traiter par Cowork. Cowork passe a processed apres mise a jour du xlsx."
    },
    "text": {
      "type": "string",
      "description": "Texte brut saisi (message ou legende photo). C'est la description terrain a interpreter."
    },
    "photos": {
      "type": "array",
      "description": "Photos jointes, deposees dans le meme dossier Drive que ce brief.json.",
      "items": {
        "type": "object",
        "required": ["filename"],
        "properties": {
          "filename": { "type": "string", "description": "Nom du fichier dans le dossier Drive." },
          "drive_file_id": { "type": "string", "description": "ID Google Drive du fichier (si connu)." },
          "mime": { "type": "string" }
        }
      }
    },
    "drive": {
      "type": "object",
      "description": "Localisation Drive du dossier de ce brief.",
      "properties": {
        "folder_id": { "type": "string" },
        "folder_name": { "type": "string" },
        "folder_url": { "type": "string", "format": "uri" }
      }
    },
    "telegram": {
      "type": "object",
      "description": "Metadonnees de provenance.",
      "properties": {
        "chat_id": { "type": ["integer", "string"] },
        "message_id": { "type": ["integer", "string"] },
        "media_group_id": { "type": ["string", "null"] },
        "user_id": { "type": ["integer", "string"] },
        "username": { "type": ["string", "null"] },
        "first_name": { "type": ["string", "null"] }
      }
    },
    "siga": {
      "type": "object",
      "description": "Zone reservee a Cowork. n8n laisse null. Cowork remplit apres traitement.",
      "properties": {
        "action": { "type": ["string", "null"], "description": "ex: ajout_outil, sortie_consommable, deplacement, retour..." },
        "items": { "type": "array", "items": { "type": "object" } },
        "processed_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
